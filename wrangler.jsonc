// Cloudflare Workers config: one Worker serves the API under /api/* and Cloudflare serves the built
// React app (static assets) for everything else. Local dev runs this same Worker inside workerd via
// @cloudflare/vite-plugin, so `npm run dev` exercises the real runtime (Durable Objects and rate
// limiters included). After changing bindings run `npm run cf-typegen`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bcycle-live-map-navigation",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Unknown paths fall back to index.html (client-side app), except /api/* and /.well-known/* (the apps' link
    // files, worker/appLinks.ts), which always hit the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.well-known/*"]
  },
  // One UpstreamGate instance per upstream group ("fossgis", "photon") enforces the public servers'
  // usage policies globally — across all users and Worker isolates. One RideAlerts instance per push
  // subscription holds that device's ride and sends its background alerts (Web Push) on alarms. One Usage
  // instance keeps the anonymous usage counts behind the usage dashboard (/analytics).
  "durable_objects": {
    "bindings": [
      { "name": "UPSTREAM_GATE", "class_name": "UpstreamGate" },
      { "name": "RIDE_ALERTS", "class_name": "RideAlerts" },
      { "name": "USAGE", "class_name": "Usage" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UpstreamGate"] },
    { "tag": "v2", "new_sqlite_classes": ["RideAlerts"] },
    { "tag": "v3", "new_sqlite_classes": ["Usage"] }
  ],
  // Per-client-IP limits on our own API so one client cannot exhaust the shared upstream budget.
  "ratelimits": [
    { "name": "ROUTE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "GEOCODE_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "PUSH_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
    // Generous: a campus or office network can put many riders behind one IP.
    { "name": "USAGE_LIMITER", "namespace_id": "1005", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    // Secrets, not set here (`npx wrangler secret put NAME` for production, `.dev.vars` for local dev):
    // CONTACT_EMAIL — operator contact for the FOSSGIS/Photon usage policies, shown in About;
    // VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY — background ride alerts (`npm run vapid-keys`); optional.
    "APP_VERSION": "1.0.0"
  },
  "observability": {
    "enabled": true
  }
}
